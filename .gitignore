# Build directories
build/
build-*/
out/
cmake-build-*/
_deps/

# vcpkg manifest-mode caches (CI restores from $env:VCPKG_ROOT)
vcpkg_installed/
.vcpkg-root

# CMake
CMakeFiles/
CMakeCache.txt
CMakeUserPresets.json
cmake_install.cmake
Makefile
compile_commands.json
install_manifest.txt

# Visual Studio / MSBuild scratch (CMake + Ninja avoids most of this but
# Visual Studio's "Open Folder" mode and IntelliSense still emit some)
.vs/
*.vcxproj.user
*.sln.docstates

# Compiler / linker artefacts
*.o
*.a
*.so
*.so.*
*.dylib
*.dSYM/
*.exe
*.dll
*.lib
*.exp
*.pdb
*.ilk
*.idb
*.obj
*.res

# Qt artefacts
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.user

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
.cache/
.ccls-cache/
.clangd/

# OS junk
.DS_Store
Thumbs.db

# Generated docs / coverage
coverage/
*.gcda
*.gcno
*.gcov
lcov.info

# Local logs / scratch
*.log
.scratch/

# Per-developer tool state. The shared `.claude/settings.json` is meant to be
# committed; `settings.local.json` is the machine-local override and is the
# file that carries personal paths and permission grants.
.claude/settings.local.json
