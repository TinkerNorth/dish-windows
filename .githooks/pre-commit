#!/usr/bin/env bash
# Reformats staged C/C++ sources in place with clang-format and re-stages
# them, then runs CI's clang-tidy gate over the staged sources in its file
# set. Skips either tool if it is not installed; CI enforces both. Runs under
# Git for Windows' bundled bash, no WSL needed.
#
# This file must stay LF-terminated: a CRLF checkout makes the kernel look
# for an interpreter named "bash\r" and the hook silently never runs.
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# -z, then split: NUL separation is what makes paths with spaces survive.
staged=$(git diff --cached --name-only --diff-filter=ACM -z \
    -- 'src/*.cpp' 'src/*.h' 'src/*.hpp' 'tests/*.cpp' 'tests/*.h' \
    | tr '\0' '\n' | sed '/^$/d')
if [ -z "$staged" ]; then
    exit 0
fi

# ── clang-format (autofix) ───────────────────────────────────────────────
if command -v clang-format >/dev/null 2>&1; then
    echo "▶ clang-format (staged files)"
    echo "$staged" | while IFS= read -r file; do
        clang-format -i "$file"
        git add "$file"
    done
else
    echo "⚠  clang-format not installed — skipping (winget install LLVM.LLVM)"
fi

# ── clang-tidy ───────────────────────────────────────────────────────────
# scripts/check-tidy.ps1 is the gate CI runs (its flags, its compile database
# view, findings fail); here it takes only the staged files in CI's set
# (src/**/*.cpp outside src/UI/), so a finding stops the commit before it
# would stop the pull request.
if command -v clang-tidy >/dev/null 2>&1; then
    # build/ is the debug preset's binaryDir (CMakePresets.json), the same
    # tree CI lints against.
    if [ -f build/compile_commands.json ]; then
        cpp_files=()
        while IFS= read -r f; do
            case "$f" in
                src/UI/*) ;;
                src/*.cpp) cpp_files+=("$f") ;;
            esac
        done <<<"$staged"
        if [ "${#cpp_files[@]}" -gt 0 ]; then
            echo "▶ clang-tidy (${#cpp_files[@]} file(s))"
            files_csv=$(IFS=,; echo "${cpp_files[*]}")
            powershell.exe -NoProfile -ExecutionPolicy Bypass \
                -File scripts/check-tidy.ps1 -BuildDir build -Files "$files_csv"
        fi
    else
        echo "⚠  build/compile_commands.json missing — run scripts/build.ps1 debug"
    fi
else
    echo "⚠  clang-tidy not installed — skipping (winget install LLVM.LLVM)"
fi
