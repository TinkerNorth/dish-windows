#!/usr/bin/env bash
# Dish Windows pre-commit hook: autofixes clang-format on staged C/C++
# sources and runs clang-tidy in advisory mode. Skips gracefully if either
# tool is missing — CI enforces both checks in strict mode. Runs under Git
# for Windows' bundled bash; you don't need WSL.
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# Collect staged C/C++ sources under src/ and tests/ (added/copied/modified),
# NUL-separated to handle paths with spaces.
staged=$(git diff --cached --name-only --diff-filter=ACM -z \
    -- 'src/*.cpp' 'src/*.h' 'src/*.hpp' 'tests/*.cpp' 'tests/*.h' \
    | tr '\0' '\n' | sed '/^$/d')
if [ -z "$staged" ]; then
    exit 0
fi

# ── clang-format (autofix) ───────────────────────────────────────────────
if command -v clang-format >/dev/null 2>&1; then
    echo "▶ clang-format (staged files)"
    echo "$staged" | while IFS= read -r file; do
        clang-format -i "$file"
        git add "$file"
    done
else
    echo "⚠  clang-format not installed — skipping (winget install LLVM.LLVM)"
fi

# ── clang-tidy (advisory) ────────────────────────────────────────────────
# Needs a compile_commands.json. We generate one in build-debug via CMake
# (CMAKE_EXPORT_COMPILE_COMMANDS is ON in CMakeLists.txt). Match CI: report
# warnings but don't block the commit on stylistic findings — .clang-tidy's
# WarningsAsErrors='' is authoritative.
if command -v clang-tidy >/dev/null 2>&1; then
    if [ -f build-debug/compile_commands.json ]; then
        cpp_files=()
        while IFS= read -r f; do
            case "$f" in
                *.cpp) cpp_files+=("$f") ;;
            esac
        done <<<"$staged"
        if [ "${#cpp_files[@]}" -gt 0 ]; then
            echo "▶ clang-tidy -p build-debug (${#cpp_files[@]} file(s))"
            clang-tidy -p build-debug --quiet "${cpp_files[@]}" || true
        fi
    else
        echo "⚠  build-debug/compile_commands.json missing — run scripts/build.ps1 debug"
    fi
else
    echo "⚠  clang-tidy not installed — skipping (winget install LLVM.LLVM)"
fi
