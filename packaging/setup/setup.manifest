<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  SPDX-License-Identifier: LGPL-3.0-or-later
  Copyright (C) 2026 Dish contributors.

  Shared side-by-side manifest, embedded into dish-setup.exe (the stub),
  dish-setup-ui.exe / uninstall.exe and uninstall-helper.exe.

  Four things it settles, none of them optional:

  - requestedExecutionLevel asInvoker. Nothing here auto-elevates. A per-user
    install must never prompt, and machine scope elevates explicitly by
    relaunching itself with ShellExecuteEx(runas) once the user has chosen it
    (spec D6). requireAdministrator here would make every silent per-user
    install pop UAC, and uiAccess=false is the default we want stated.

  - Common-Controls 6.0.0.0. The stub statically imports TaskDialogIndirect,
    which only exists in the v6 comctl32 side-by-side assembly. WITHOUT this
    dependency dish-setup.exe does not merely lose its themed dialog, it fails
    to load at all.

  - PerMonitorV2 DPI awareness. The wizard is a Qt Quick window that gets
    dragged between a laptop panel and an external monitor mid-install; system
    DPI awareness would bitmap-stretch it.

  - longPathAware. Install directories are user-chosen and the copy loop walks
    a manifest of nested paths; the engine also uses \\?\ prefixes, but the
    two together are what make >MAX_PATH actually work on Windows 10 1607+.

  supportedOS lists Windows 10/11 (the same GUID covers both) so version
  queries report the real build instead of the 6.2 compatibility lie the OS
  tells unmanifested binaries. The stub's own gate is >= 10.0.17763.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="TinkerNorth.Dish.Setup" version="1.0.0.0"
                    processorArchitecture="amd64"/>

  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls"
                        version="6.0.0.0" processorArchitecture="amd64"
                        publicKeyToken="6595b64144ccf1df" language="*"/>
    </dependentAssembly>
  </dependency>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
