//
// VERSIONINFO + icon for dish-setup-ui.exe, which is also byte-copied into the
// install directory as uninstall.exe (spec D9). OriginalFilename therefore
// names the staged binary, not the installed alias — Explorer shows the
// alias's own name, and claiming otherwise would be a lie in the properties
// dialog of a file people check before trusting it.
//
// configure_file'd from PROJECT_VERSION by installer/CMakeLists.txt.

#include <windows.h>

IDI_DISH_ICON ICON "@DISH_SETUP_ICON@"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
    PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
    FILEFLAGS      0
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_APP
    FILESUBTYPE    0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "TinkerNorth"
            VALUE "FileDescription",  "Dish Setup"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "dish-setup-ui"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Dish contributors. LGPL-3.0-or-later."
            VALUE "OriginalFilename", "dish-setup-ui.exe"
            VALUE "ProductName",      "Dish"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
