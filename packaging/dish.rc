//
// Windows resource file. Embeds the application icon and the version-info
// block Explorer / Task Manager / PowerShell `Get-ItemProperty` read.
//
// Update the version numbers in two places when bumping a release:
//   - FILEVERSION / PRODUCTVERSION (numeric tuples)
//   - StringFileInfo "FileVersion" / "ProductVersion" (display strings)
// The CMake project version (`project(Dish VERSION ...)`) is the
// canonical source — keep both in sync.

#include <windows.h>

IDI_DISH_ICON ICON "dish.ico"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    0,1,0,0
    PRODUCTVERSION 0,1,0,0
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
    FILEFLAGS      0
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_APP
    FILESUBTYPE    0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "TinkerNorth"
            VALUE "FileDescription",  "Dish — wireless gamepad client for Satellite"
            VALUE "FileVersion",      "0.1.0"
            VALUE "InternalName",     "dish"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Dish contributors. LGPL-3.0-or-later."
            VALUE "OriginalFilename", "dish.exe"
            VALUE "ProductName",      "Dish"
            VALUE "ProductVersion",   "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
